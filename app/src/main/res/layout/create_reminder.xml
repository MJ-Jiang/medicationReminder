<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#f5f5f5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Reminder Name Field -->
        <TextView
            android:id="@+id/textViewNameLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reminder_name"
            android:textSize="16sp"
            android:paddingBottom="8dp"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/editTextName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/name_description"
            android:padding="16dp"
            android:background="@drawable/edit_text_border"
            android:minHeight="48dp"
            android:textColor="#000000" />

        <!-- Description Field -->
        <TextView
            android:id="@+id/textViewDescriptionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reminder_description"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/editTextDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/description_description"
            android:padding="16dp"
            android:background="@drawable/edit_text_border"
            android:minHeight="48dp"
            android:textColor="#000000" />

        <!-- Dosage Field -->
        <TextView
            android:id="@+id/textViewDosageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reminder_dosage"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/editTextDosage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/description_dosage"
            android:padding="16dp"
            android:background="@drawable/edit_text_border"
            android:minHeight="48dp"
            android:textColor="#000000" />

        <!-- Start Date Field -->
        <TextView
            android:id="@+id/textViewStartDateLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reminder_startdate"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/textViewStartDateValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/description_startdate"
            android:background="@drawable/edit_text_border"
            android:padding="16dp"
            android:minHeight="48dp"
            android:clickable="true"
            android:focusable="true"
            android:textColor="#000000" />

        <!-- End Date Field -->
        <TextView
            android:id="@+id/textViewEndDateLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reminder_enddate"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/textViewEndDateValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/description_enddate"
            android:background="@drawable/edit_text_border"
            android:padding="16dp"
            android:minHeight="48dp"
            android:clickable="true"
            android:focusable="true"
            android:textColor="#000000" />

        <!-- Frequency Field -->
        <TextView
            android:id="@+id/textViewFrequencyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frequency"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textColor="#000000" />

        <Spinner
            android:id="@+id/spinnerFrequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@drawable/edit_text_border"
            android:minHeight="48dp"
            android:textColor="#000000" />

        <!-- Reminder Time Fields -->
        <TextView
            android:id="@+id/textViewReminderTimeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reminder_time"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textColor="#000000" />

        <!-- New time fields container -->
        <LinearLayout
            android:id="@+id/linearLayoutTimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />

        <!-- Create Button -->
        <Button
            android:id="@+id/buttonCreateReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_reminder"
            android:layout_marginTop="32dp"
            android:padding="16dp"
            android:background="#FF4081"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>

    <!--android:fillViewport="true" 用于 ScrollView 或 NestedScrollView，它的作用是让 ScrollView 内部的内容填满可见区域（即填满视口）。
    如果内容不足以填充整个视口，ScrollView 会自动拉伸内容，以确保填满屏幕。-->